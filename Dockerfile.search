# OpenSERP search service — wraps the prebuilt karust/openserp image and
# starts it with an explicit command on Render's assigned port (default
# 10000). `openserp` without arguments prints usage and exits 128; this
# layer overwrites the missing CMD.
FROM karust/openserp:latest
ENV OPENSERP_SERVER_HOST=0.0.0.0
ENV OPENSERP_SERVER_PORT=10000
EXPOSE 10000
CMD ["serve", "--host", "0.0.0.0", "--port", "10000"]
